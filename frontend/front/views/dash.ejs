<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>User Dashboard</title>

<style>
  * {
    box-sizing: border-box;
    font-family: Arial, sans-serif;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
  }

  /* Top Navbar */
  .navbar {
    height: 60px;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 30px;
  }

  .navbar h2 {
    margin: 0;
  }

  .logout {
    background: rgba(255,255,255,0.2);
    border: none;
    padding: 8px 16px;
    border-radius: 20px;
    color: white;
    cursor: pointer;
  }

  .logout:hover {
    background: rgba(255,255,255,0.3);
  }

  /* Main Content */
  .content {
    padding: 40px;
    animation: fadeIn 1s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 30px;
  }

  .card {
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(10px);
    padding: 25px;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 15px 30px rgba(0,0,0,0.2);
    transition: transform 0.3s;
  }

  .card:hover {
    transform: translateY(-8px);
  }

  .card h3 {
    margin-bottom: 10px;
  }

  .card p {
    font-size: 14px;
    opacity: 0.9;
  }
</style>
</head>

<body>

<!-- NAVBAR -->
<div class="navbar">
  <h2>My Dashboard</h2>
  <a href='in'><button class="logout" >Logout</button></a>
</div>

<!-- MAIN CONTENT -->
<div class="content">
  <h1>Welcome, <%= ruser%> 👋</h1>
  <p>This is your dashboard overview</p>

  <div class="cards">
    <div class="card">
      <h3>Profile</h3>
      <p>View & update your profile</p>
    </div>

    <div class="card">
      <h3>Settings</h3>
      <p>Manage your account settings</p>
    </div>

    <div class="card">
      <h3>Messages</h3>
      <p>Check your notifications</p>
    </div>

    <div class="card">
      <h3>Reports</h3>
      <p>View your activity reports</p>
    </div>
  </div>
</div>

</body>
</html> 